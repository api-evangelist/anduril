{
  "opencollection": "1.0.0",
  "info": {
    "name": "Anduril Lattice REST Entities OAuth API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "OAuth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Issue an access token (client credentials grant)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.{environment}.anduril.com/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Exchange client_id and client_secret for a short-lived bearer access token."
        }
      ]
    }
  ],
  "bundled": true
}